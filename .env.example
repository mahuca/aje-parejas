# Copia este archivo a .env solo para pruebas locales.
# En Render las variables se configuran en el panel (o con el Blueprint).

# Postgres. Sin esta variable la app guarda en memoria y pierde todo al reiniciar.
DATABASE_URL=

# Sal que se mezcla con la clave de cada jugador. Si la cambias, todas las
# claves existentes dejan de valer.
PIN_PEPPER=

# Protege el panel de administración (cabecera x-admin-token).
ADMIN_TOKEN=

# URL pública para los enlaces de los mensajes.
BASE_URL=http://localhost:3001
PORT=3001
TZ=Europe/Madrid

# Telegram (opcional en local).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
